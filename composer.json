{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "ahmaruff/laravel-htmx-table",
    "description": "A lightweight server-driven table for Laravel using blade and HTMX",
    "keywords": [
        "laravel",
        "htmx",
        "table",
        "datatable",
        "blade",
        "ahmaruff",
        "laravel-htmx-table"
    ],
    "homepage": "https://github.com/ahmaruff/laravel-htmx-table",
    "support": {
        "issues": "https://github.com/ahmaruff/laravel-htmx-table/issues",
        "source": "https://github.com/ahmaruff/laravel-htmx-table",
        "docs": "https://github.com/ahmaruff/laravel-htmx-table/tree/main/docs"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmad Ma'ruf",
            "email": "ahmadmaruf2701@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "illuminate/support": "^10.50.3 || ^11.56.1 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.11 || ^3.15",
        "laravel/pint": "~1.32.3",
        "orchestra/testbench": "^8.39 || ^9.18 || ^10.12 || ^11.3",
        "pestphp/pest": "^2.36 || ^3.8 || ^4.6 || ^5.0",
        "pestphp/pest-plugin-laravel": "^2.4 || ^3.2 || ^4.1 || ^5.0",
        "pestphp/pest-plugin-type-coverage": "^2.8 || ^3.2 || ^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmaruff\\HtmxTable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmaruff\\HtmxTable\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmaruff\\HtmxTable\\HtmxTableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
